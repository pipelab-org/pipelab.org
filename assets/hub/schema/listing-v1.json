          "pattern": "^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_.-]+)*$",
          "format": "artifact-path"
        }
      },
      "required": [
        "schema_version",
        "type",
        "id",
        "title",
        "summary",
        "maintainer",
        "license",
        "evidence",
        "setup",
        "limitations",
        "not_claimed",
        "links",
        "disclosures",
        "language",
        "release",
        "conformance_artifact"
      ]
    }
  ]
}
