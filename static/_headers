# /buildhop/ is the reusable launch / directory landing page. It is framed by
# BuildHop for a live preview, so frame-ancestors allows the BuildHop origins
# (and self) for THIS PATH ONLY; every other route stays frame-ancestors 'none'.
# X-Frame-Options is dropped here because it cannot allow-list a cross-origin
# parent. Keep this CSP in sync with the /* CSP above: identical except the
# frame-ancestors directive and 'self' in frame-src, which permits this page's
# direct-visit replay iframe without adding an external frame source.
/buildhop/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://buildhop.io https://www.buildhop.io; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://analytics.ahrefs.com https://us-assets.i.posthog.com https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://verifieddr.com; connect-src 'self' https://www.google-analytics.com https://api.github.com https://us.i.posthog.com https://us-assets.i.posthog.com https://analytics.ahrefs.com https://challenges.cloudflare.com; form-action 'self' https://buttondown.com; frame-src 'self' https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com

# The /playground/ page embeds the cross-origin live demo host
# (playground.pipelab.org) in an iframe. Allow framing self + the live demo host
# for these paths (external framing of this site still blocked via
# frame-ancestors). Keep this CSP in sync
# with the /* CSP above: it is identical except frame-ancestors 'self',
# frame-src adds 'self' + https://playground.pipelab.org, and connect-src
# allows the Turnstile endpoint used by the embedded live human gate.
/playground/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://analytics.ahrefs.com https://us-assets.i.posthog.com https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://api.github.com https://us.i.posthog.com https://us-assets.i.posthog.com https://analytics.ahrefs.com https://challenges.cloudflare.com; form-action 'self' https://buttondown.com; frame-src 'self' https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com https://playground.pipelab.org

/playground/demo/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'self' https://buildhop.io https://www.buildhop.io; script-src 'self' blob: 'wasm-unsafe-eval' https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'

# The /agent-evidence/ and /verify/ pages compile the pinned Pipelock verifier
# as WebAssembly in the browser, which CSP treats as eval unless script-src
# grants 'wasm-unsafe-eval'. Same mechanism as /playground/demo/* above. Keep
# these two CSPs in sync with the /* CSP: identical except that one grant.
/agent-evidence/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://buildhop.io https://www.buildhop.io; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com https://analytics.ahrefs.com https://us-assets.i.posthog.com https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://verifieddr.com; connect-src 'self' https://www.google-analytics.com https://api.github.com https://us.i.posthog.com https://us-assets.i.posthog.com https://analytics.ahrefs.com https://challenges.cloudflare.com; form-action 'self' https://buttondown.com; frame-src 'self' https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com

