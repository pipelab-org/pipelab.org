    {
      "id": "agent-containment",
      "group": "enforcement",
      "name": "Host containment for agent processes",
      "summary": "Installs, verifies, and rolls back nftables-backed host containment.",
      "tier": "Free",
      "access_tiers": [
        "free",
        "pro",
        "enterprise"
      ],
      "operator_entry_point": {
        "kind": "command",
        "value": "pipelock contain",
        "source": {
          "file": "internal/cli/contain/cmd.go",
          "symbol": "Cmd"
        }
      },
      "implementation": {
        "file": "internal/cli/contain/cmd.go",
        "symbol": "Cmd"
      },
      "detail": {
        "family": "process-containment",
        "path": "/capabilities/agent-containment/"
      },
      "availability": {
        "scope": "platform_dependent",
        "qualifier": "Kernel-enforced containment requires Linux, a private network namespace, nftables, and the managed identities. The recommended unprivileged systemd service emits signed pre-launch posture from a root signer that verifies its own managed namespace, live runtime mounts, and proxy doorway; contain run instead signs a host-side preflight and also emits a post-session workspace statement. Filesystem confinement is a separate containment.filesystem.mode setting. enforce hides the host filesystem with ProtectSystem=strict and ProtectHome=tmpfs and binds the agent home plus unexpired workspace grants. Every managed launch hides host /run and /dev/shm and binds only the namespace identity under /run; systemd may add its own read-only, empty mount-propagation directory at /run/systemd/incoming. Omitted or off otherwise retains host filesystem visibility. A process that can create a user namespace can remount, same-uid /proc stays visible, private /tmp is shared with the network-namespace anchor and its forwarders, and operator-written units are left unchanged."
      }
    },
    {
      "id": "single-agent-sandbox",
      "group": "enforcement",
      "name": "Single-agent process sandbox",
      "summary": "Runs one command with unprivileged process and filesystem restrictions.",
      "tier": "Free",
      "access_tiers": [
        "free",
        "pro",
        "enterprise"
      ],
      "operator_entry_point": {
        "kind": "command",
        "value": "pipelock sandbox",
        "source": {
          "file": "internal/cli/runtime/sandbox.go",
          "symbol": "SandboxCmd"
        }
      },
      "implementation": {
        "file": "internal/cli/runtime/sandbox.go",
        "symbol": "SandboxCmd"
      },
      "detail": {
        "family": "process-containment",
        "path": "/capabilities/single-agent-sandbox/"
      },
      "availability": {
        "scope": "platform_dependent",
        "qualifier": "Kernel isolation requires Linux user namespaces. Without them, best-effort network isolation only sets HTTP(S)_PROXY; seccomp adds restrictions only on linux/amd64. Unix socket isolation uses Landlock ABI 9 for pathname sockets and ABI 6 for abstract sockets; older linux/amd64 kernels deny Unix socket creation and datagram socketpairs in the workload while retaining connected stream and sequenced-packet pairs and the proxy bridge."
      }
    },
